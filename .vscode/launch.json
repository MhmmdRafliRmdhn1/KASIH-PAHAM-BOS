{
    "version": "0.2.0",
    "configurations": [
        {
            "command": "pnpm dev",
            "name": "Run pnpm dev",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "name": "Launch Chrome (http://127.0.0.1:8080)",
            "request": "launch",
            "type": "chrome",
            "url": "http://127.0.0.1:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open index.html (Direct)",
            "request": "launch",
            "type": "chrome",
            "file": "${workspaceFolder}\\index.html"
        }
    ]
}